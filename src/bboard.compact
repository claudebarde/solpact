// auto-generated code from Solidity source
pragma language_version >= 0.16 && <= 0.18;

witness localSecretKey(): Bytes<32>;

import CompactStandardLibrary;

export enum State { VACANT, OCCUPIED }

export ledger state: State;
export ledger message: Maybe<Opaque<"string">>;
export ledger round: Counter;
export ledger owner: Bytes<32>;

constructor() {
    state = State.VACANT;
    round.increment(1);
    message = none();
}

circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
    return persistentHash([pad(32, "bboard:pk:"), sequence, sk]);
}

export circuit post(newMessage: Opaque<"string">): [] {
    assert(state == State.VACANT, "Attempted to post to an occupied board");
    owner = publicKey(disclose(localSecretKey()), round.toBytes32());
    message = some<Opaque<"string">>(disclose(newMessage));
    state = State.OCCUPIED;
}

export circuit takeDown(): Opaque<"string"> {
    assert(state == State.OCCUPIED, "Attempted to take down a vacant board");
    assert(owner == publicKey(ownPublicKey(), round.toBytes32()), "Only the original poster can take down the message");
    formerMsg = message.value;
    state = State.VACANT;
    message = none();
    round.increment(1);
    return formerMsg;
}
